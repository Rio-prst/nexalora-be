{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm install --frozen-lockfile && pnpm run prisma:generate && pnpm run build",
  "outputDirectory": "dist",
  "functions": {
    "dist/vercel.js": {
      "maxDuration": 60
    }
  }
}