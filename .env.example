# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL from Supabase.
# DATABASE_URL -> Prisma Client (runtime aplikasi).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# DIRECT_URL -> Prisma CLI (migrate dev, migrate deploy, db push).
# Memakai koneksi langsung tanpa pooler karena Prisma CLI butuh
# advisory lock yang tidak kompatibel dengan connection pooling.
# CATATAN: host db.PROJECT_REF.supabase.co sering IPv6-only.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Repository integration tests run against an isolated schema in the same database.
# Used by `pnpm test:integration` only.
DATABASE_URL_TEST="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=test"

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d